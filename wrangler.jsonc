{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "galapa-themes",
  "compatibility_date": "2026-08-01",

  // Static SPA: serve the Vite build directly (no Worker script needed), and
  // fall back to index.html for client-side routes (TanStack Router).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Attach the app to its own hostname. Requires the galapa.app zone to be in
  // this Cloudflare account; wrangler provisions the DNS record + cert.
  "routes": [{ "pattern": "themes.galapa.app", "custom_domain": true }]
}
