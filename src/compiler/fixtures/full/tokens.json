{
  "$schema": "https://galapa-dqx.github.io/themes/theme-project/tokens.schema.json",
  "colors": {
    "bg": "#123456",
    "text": "#f5fdfa",
    "accent": "{colors.bg}",
    "muted": {
      "$type": "mix",
      "inputs": ["{colors.bg}", "#ffffff"],
      "amount": 0.5,
      "space": "oklab"
    }
  },
  "fonts": {
    "heading": "gfont:Space+Grotesk",
    "body": "./assets/sg.ttf",
    "display": "./assets/sg.ttc"
  },
  "assets": {
    "dot": "./assets/dot.svg",
    "tinted": "{assets.dot-alias}",
    "dot-alias": "./assets/dot.svg"
  },
  "typography": {
    "base": {
      "font": "{fonts.body}",
      "fontWeight": 600,
      "fontSize": 12
    },
    "heading": {
      "$extends": "{typography.base}",
      "font": "{fonts.heading}",
      "fontWeight": 400,
      "fontSize": 14,
      "lineHeight": 1.4,
      "textCase": "uppercase"
    },
    "display": {
      "font": "{fonts.display}",
      "fontWeight": 700,
      "fontSize": 18
    }
  }
}
