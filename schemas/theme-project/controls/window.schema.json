{
  "$id": "https://schemas.galapa.app/theme-project/controls/window.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://schemas.galapa.app/theme-project/controls/window.schema.json",
      "type": "string"
