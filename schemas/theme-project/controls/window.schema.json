            {
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            {
              "pattern": "^\\{colors\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\}$",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "$type": {
                  "const": "mix",
                  "type": "string"
                },
                "amount": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "inputs": {
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "anyOf": [
                        {
                          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                          "type": "string"
                        },
                        {
                          "pattern": "^\\{colors\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\}$",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                          "type": "string"
                        },
                        {
                          "pattern": "^\\{colors\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\}$",
