                },
                "space": {
                  "anyOf": [
                    {
                      "const": "srgb",
                      "type": "string"
                    },
                    {
                      "const": "srgb-linear",
                      "type": "string"
                    },
                    {
                      "const": "lab",
                      "type": "string"
                    },
                    {
                      "const": "lch",
                      "type": "string"
                    },
                    {
                      "const": "oklab",
                      "type": "string"
                    },
                    {
                      "const": "oklch",
                      "type": "string"
