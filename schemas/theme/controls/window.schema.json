{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "borderColor": {
      "anyOf": [
        {
          "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "type": "string"
        },
        {
          "const": "none",
          "type": "string"
        }
      ]
    },
    "fill": {
      "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "type": "string"
    }
  },
  "required": [
    "fill",
    "borderColor"
  ],
  "type": "object"
}
