{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "color": {
      "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "type": "string"
    },
    "offset": {
      "type": "number"
    },
    "width": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "color",
    "width",
    "offset"
  ],
  "type": "object"
}
