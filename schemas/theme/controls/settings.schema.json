{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "parts": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "additionalProperties": false,
          "properties": {
            "color": {
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            "opacity": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "typography": {
              "additionalProperties": false,
              "properties": {
                "font": {
                  "pattern": "^\\./assets/fonts/[0-9a-f]{12}\\.(?:ttf|otf)$",
                  "type": "string"
                },
                "fontFeatures": {
                  "additionalProperties": false,
                  "patternProperties": {
                    "^.*$": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "minimum": 0,
                          "type": "integer"
                        }
                      ]
                    }
                  },
                  "propertyNames": {
                    "pattern": "^[ -~]{4}$"
                  },
                  "type": "object"
                },
                "fontSize": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "fontStyle": {
                  "anyOf": [
                    {
                      "const": "normal",
                      "type": "string"
                    },
                    {
                      "const": "italic",
                      "type": "string"
                    },
                    {
                      "const": "oblique",
                      "type": "string"
                    }
                  ]
                },
                "fontWeight": {
                  "maximum": 1000,
                  "minimum": 1,
                  "type": "integer"
                },
                "letterSpacing": {
                  "type": "number"
                },
                "lineHeight": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "textCase": {
                  "anyOf": [
                    {
                      "const": "none",
                      "type": "string"
                    },
                    {
                      "const": "uppercase",
                      "type": "string"
                    },
                    {
                      "const": "lowercase",
                      "type": "string"
                    }
                  ]
                },
                "textDecoration": {
                  "items": {
                    "anyOf": [
                      {
                        "const": "underline",
                        "type": "string"
                      },
                      {
                        "const": "strikethrough",
                        "type": "string"
                      },
                      {
                        "const": "overline",
                        "type": "string"
                      },
                      {
                        "const": "baseline",
                        "type": "string"
                      }
                    ]
                  },
                  "type": "array",
                  "uniqueItems": true
                }
              },
              "required": [
                "font",
                "fontWeight",
                "fontStyle",
                "fontSize",
                "lineHeight",
                "letterSpacing",
                "textCase",
                "textDecoration",
                "fontFeatures"
              ],
              "type": "object"
            }
          },
          "required": [
            "color",
            "typography",
            "opacity"
          ],
          "type": "object"
        }
      },
      "required": [
        "heading"
      ],
      "type": "object"
    }
  },
  "required": [
    "parts"
  ],
  "type": "object"
}
