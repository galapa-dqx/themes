{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "parts": {
      "additionalProperties": false,
      "properties": {
        "ornament": {
          "additionalProperties": false,
          "properties": {
            "asset": {
              "pattern": "^\\./assets/[0-9a-f]{12}\\.svg$",
              "type": "string"
            },
            "currentColor": {
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            "opacity": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "size": {
              "additionalProperties": false,
              "properties": {
                "height": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "width": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "asset",
            "opacity"
          ],
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "parts"
  ],
  "type": "object"
}
