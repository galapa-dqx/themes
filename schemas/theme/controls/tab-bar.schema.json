{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "parts": {
      "additionalProperties": false,
      "properties": {
        "hint": {
          "additionalProperties": false,
          "properties": {
            "assets": {
              "additionalProperties": false,
              "properties": {
                "left-bumper": {
                  "pattern": "^\\./assets/[0-9a-f]{12}\\.svg$",
                  "type": "string"
                },
                "left-trigger": {
                  "pattern": "^\\./assets/[0-9a-f]{12}\\.svg$",
                  "type": "string"
                },
                "right-bumper": {
                  "pattern": "^\\./assets/[0-9a-f]{12}\\.svg$",
                  "type": "string"
                },
                "right-trigger": {
                  "pattern": "^\\./assets/[0-9a-f]{12}\\.svg$",
                  "type": "string"
                }
              },
              "required": [
                "left-bumper",
                "right-bumper",
                "left-trigger",
                "right-trigger"
              ],
              "type": "object"
            },
            "currentColor": {
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "type": "string"
            },
            "opacity": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "size": {
              "additionalProperties": false,
              "properties": {
                "height": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "width": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "assets",
            "currentColor",
            "opacity"
          ],
          "type": "object"
        }
      },
      "required": [
        "hint"
      ],
      "type": "object"
    }
  },
  "required": [
    "parts"
  ],
  "type": "object"
}
