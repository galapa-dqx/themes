{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "chromeStyle": {
      "anyOf": [
        {
          "const": "light",
          "type": "string"
        },
        {
          "const": "dark",
          "type": "string"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "id": {
      "pattern": "^app\\.galapa\\.themes\\.[a-z0-9]{20}$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "previewImage": {
      "pattern": "^\\./assets/[0-9a-f]{12}\\.(?:png|jpg)$",
      "type": "string"
    },
    "updates": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "frequency": {
              "anyOf": [
                {
                  "const": "hourly",
                  "type": "string"
                },
                {
                  "const": "daily",
                  "type": "string"
                },
                {
                  "const": "weekly",
                  "type": "string"
                }
              ]
            },
            "url": {
              "pattern": "^https://",
              "type": "string"
            }
          },
          "required": [
            "url",
            "frequency"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "author",
    "updates",
    "chromeStyle"
  ],
  "type": "object"
}
