{
  "$schema": "https://galapa-dqx.github.io/themes/theme-project/tokens.schema.json",
  "colors": {
    "bg": "#edfaf5",
    "surface": "#f5fdfa",
    "surface-2": "#d8f4ec",
    "border": "#a8e0cc",
    "text": "#0a2820",
    "muted": "#3a7860",
    "accent": "#22aa78",
    "success": "#2a8a4a",
    "danger": "#c03040"
  },
  "fonts": {
    "space-grotesk": "gfont:Space+Grotesk",
    "source-sans-3": "gfont:Source+Sans+3"
  },
  "assets": {
    "carousel-nav": "./assets/carousel-nav.svg",
    "carousel-nav-hover": "./assets/carousel-nav-hover.svg",
    "carousel-pip": "./assets/carousel-pip.svg",
    "carousel-pip-selected": "./assets/carousel-pip-selected.svg",
    "play-squares": "./assets/play-squares.svg"
  },
  "typography": {
    "heading": {
      "font": "{fonts.space-grotesk}",
      "fontWeight": 700,
      "fontSize": 14
    },
    "body": {
      "font": "{fonts.source-sans-3}",
      "fontWeight": 400,
      "fontSize": 14
    },
    "strong": {
      "font": "{fonts.space-grotesk}",
      "fontWeight": 700,
      "fontSize": 14
    }
  }
}
