{
  "$schema": "https://galapa-dqx.github.io/themes/theme-project/controls/news-item.schema.json",
  "shape": "path",
  "fill": "{colors.surface}",
  "border": {
    "color": "{colors.border}",
    "thickness": 1
  },
  "padding": [0, 12, 0, 12],
  "size": {
    "height": 43
  },
  "states": {
    "hover": {
      "border": {
        "color": "{colors.muted}"
      }
    }
  },
  "parts": {
    "title": {
      "color": "{colors.muted}",
      "typography": {
        "$extends": "{typography.strong}",
        "fontSize": 16
      }
    },
    "date": {
      "color": {
        "$type": "mix",
        "inputs": ["{colors.border}", "{colors.muted}"],
        "amount": 0.6,
        "space": "oklab"
      },
      "typography": {
        "$extends": "{typography.body}",
        "fontSize": 13,
        "letterSpacing": 0.1
      }
    },
    "gem": {
      "currentColor": "{colors.muted}"
    }
  }
}
