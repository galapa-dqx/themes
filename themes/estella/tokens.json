{
  "$schema": "https://galapa-dqx.github.io/themes/theme-project/tokens.schema.json",
  "colors": {
    "bg": "#eef4f8",
    "surface": "#f5f9fc",
    "surface-2": "#dde8f0",
    "border": "#b8ccd8",
    "text": "#0e1e28",
    "muted": "#4a6a80",
    "accent": "#3878aa",
    "success": "#2a7a3a",
    "danger": "#c04040"
  },
  "fonts": {
    "playfair-display": "gfont:Playfair+Display",
    "source-sans-3": "gfont:Source+Sans+3"
  },
  "assets": {
    "carousel-nav": "./assets/carousel-nav.svg",
    "carousel-nav-hover": "./assets/carousel-nav-hover.svg",
    "carousel-pip": "./assets/carousel-pip.svg",
    "carousel-pip-selected": "./assets/carousel-pip-selected.svg"
  },
  "typography": {
    "heading": {
      "font": "{fonts.playfair-display}",
      "fontWeight": 600,
      "fontStyle": "italic",
      "fontSize": 14
    },
    "body": {
      "font": "{fonts.source-sans-3}",
      "fontWeight": 400,
      "fontSize": 14
    },
    "strong": {
      "font": "{fonts.playfair-display}",
      "fontWeight": 700,
      "fontSize": 14
    }
  }
}
