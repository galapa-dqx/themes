{
  "$schema": "https://galapa-dqx.github.io/themes/theme-project/tokens.schema.json",
  "colors": {
    "bg": "#0d0608",
    "surface": "#150b10",
    "surface-2": "#1e1018",
    "border": "#3a1a28",
    "text": "#f0e0e8",
    "muted": "#9a6878",
    "accent": "#c82040",
    "success": "#4caf82",
    "danger": "#e07040"
  },
  "fonts": {
    "crimson-pro": "gfont:Crimson+Pro",
    "source-sans-3": "gfont:Source+Sans+3"
  },
  "assets": {
    "carousel-nav": "./assets/carousel-nav.svg",
    "carousel-nav-hover": "./assets/carousel-nav-hover.svg",
    "carousel-pip": "./assets/carousel-pip.svg",
    "carousel-pip-selected": "./assets/carousel-pip-selected.svg"
  },
  "typography": {
    "heading": {
      "font": "{fonts.crimson-pro}",
      "fontWeight": 700,
      "fontSize": 14
    },
    "body": {
      "font": "{fonts.source-sans-3}",
      "fontWeight": 400,
      "fontSize": 14
    },
    "strong": {
      "font": "{fonts.crimson-pro}",
      "fontWeight": 700,
      "fontSize": 14
    }
  }
}
