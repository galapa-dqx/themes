{
  "$schema": "https://galapa-dqx.github.io/themes/theme-project/controls/setting-help.schema.json",
  "parts": {
    "title": {
      "color": "{colors.text}",
      "typography": {
        "$extends": "{typography.heading}",
        "fontSize": 16,
        "lineHeight": 1.2,
        "textCase": "uppercase"
      }
    },
    "body": {
      "color": "{colors.text}",
      "typography": {
        "$extends": "{typography.body}",
        "fontSize": 13,
        "lineHeight": 1.45
      }
    }
  }
}
